ADMIN_KEY=replace-with-your-admin-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourname@gmail.com
SMTP_PASSWORD=your-gmail-app-password
MAIL_FROM=yourname@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
FLASK_SECRET_KEY=replace-with-a-long-random-string
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMAIL_REMINDER_INTERVAL_SECONDS=900
EMAIL_REMINDER_LEAD_HOURS=72